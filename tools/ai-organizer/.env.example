# Cursor Dashboard → Integrations → User API Keys
CURSOR_API_KEY=cursor_your-key-here

# 選填
# CURSOR_MODEL=composer-2.5
# CURSOR_CWD=../../

# AI 整理（預設：完整 SKILL；節點列表仍為緊湊 JSON 以省 token）
# FTC_ORGANIZE_FULL_SKILL=1
# FTC_ORGANIZE_COMPACT=1
# FTC_ORGANIZE_GUIDE_MAX_CHARS=3500

# 示意圖：base64 超過約 400KB 時自動縮邊轉 JPEG（需 sharp）
# FTC_ORGANIZE_IMAGE_COMPRESS_B64=400000
# FTC_ORGANIZE_IMAGE_MAX_EDGE=1920
# FTC_ORGANIZE_IMAGE_JPEG_QUALITY=82
# FTC_ORGANIZE_SKIP_IMAGE_COMPRESS=1
